# 기술 Validator 전용 인증키
#
#   cp spike/validation/.env.example spike/validation/.env
#   chmod 600 spike/validation/.env
#
# 우선순위:
#   운영체제 환경변수 > 이 파일 > find-path/.env
#
# 실제 키는 커밋하지 않는다.

# SK OpenAPI TMAP appKey
TMAP_APP_KEY=

# 카카오디벨로퍼스 REST API 키
KAKAO_REST_API_KEY=

# 공공데이터포털 15157604 보행신호 실시간 정보 키
# 비워두면 루트 find-path/.env의 DATA_GO_KR_KEY를 사용한다.
SIGNAL_API_KEY=
